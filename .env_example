# ─────────────────────────────────────────────────────────────
# LawGrid environment template
# Copy this file to .env (or backend/.env) and fill in what you have.
# Every cloud integration is optional: with no keys the API still runs
# in local fallback mode for text intake, legal research, strategy and drafts.
# NEVER commit a real .env file.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
APP_NAME=LawGrid
APP_VERSION=4.1.0
# Set true for shared/production deployments. Local demo can keep false.
AUTH_REQUIRED=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_SIZE_MB=20

# ── Supabase (required for login, dashboard, marketplace) ─────
# Create a free project at https://supabase.com and copy these from
# Project Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy JWT secret (Project Settings → API → JWT Settings).
# New projects may use ES256/JWKS; leave blank if your project uses it.
SUPABASE_JWT_SECRET=

# ── Frontend (Next.js) ───────────────────────────────────────
NEXT_PUBLIC_APP_NAME=LawGrid
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# true = local demo without login. Set false after configuring Supabase.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── AI providers (optional; local fallback used if absent) ────
GROQ_API_KEY=
SARVAM_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ── Qdrant vector search (optional) ──────────────────────────
# Leave blank to use the built-in local legal corpus fallback.
# For local Docker: QDRANT_URL=http://localhost:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=nyay_ai_laws
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Neo4j graph explorer (optional, off by default) ─────────
NEO4J_GRAPH_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_CORPUS_PATH=app/data/corpus

# ── Postgres / Redis (reserved for future production use) ───
DATABASE_URL=
SYNC_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

# ── Pipeline ─────────────────────────────────────────────────
STRATEGY_ENGINE=groq
PIPELINE_TIMEOUT_SECONDS=45
PIPELINE_CONFIDENCE_THRESHOLD=0.6
