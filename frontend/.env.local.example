# Copy to frontend/.env.local
# Local demo: no Supabase required. Chat, analysis and drafts work immediately.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: set these to enable login, role routing and the lawyer marketplace.
# Keep NEXT_PUBLIC_DEMO_MODE=false when Supabase is configured.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
